# Backend environment variables (example)

# --- App ---
NODE_ENV=development
PORT=3001

# --- Database ---
# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
# Managed PostgreSQL example:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# --- Auth / JWT ---
JWT_SECRET=CHANGE_ME

# --- CORS ---
# Comma-separated list
ALLOWED_ORIGINS=http://localhost:3002,http://localhost:3000

# --- Uploads ---
# Where uploaded files are stored on disk
UPLOADS_DIR=uploads

# Optional S3-compatible object storage (AWS S3 or Cloudflare R2)
# If these are set, uploads are stored in object storage instead of local disk.
# S3 endpoint example: https://s3.eu-central-1.amazonaws.com
# R2 endpoint example: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Public CDN/base URL for uploaded files (recommended)
UPLOADS_PUBLIC_BASE_URL=

# --- Public storefront business selection ---
PUBLIC_BUSINESS_ID=1

# --- Site / Email ---
SITE_NAME=Nutopiano
SITE_URL=http://localhost:3002
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# --- SMTP (optional, for email sending) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_FROM=no-reply@nutopiano.com
SUPPORT_EMAIL=support@nutopiano.com

# --- Redis (optional, for throttling/cache/queue/health checks) ---
REDIS_URL=redis://localhost:6379
MARKETPLACE_CACHE_TTL_SECONDS=60

# --- Sentry (optional, for production error monitoring) ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Backup (optional, used by scripts/backup-postgres.sh) ---
BACKUP_DIR=/var/backups/nutopiano/postgres
BACKUP_RETENTION_DAYS=14
