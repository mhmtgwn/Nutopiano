// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())

  users               User[]
  customers           Customer[]
  products            Product[]
  productVariants     ProductVariant[]
  productImages       ProductImage[]
  categories          Category[]
  orders              Order[]
  orderStatuses       OrderStatus[]
  orderItems          OrderItem[]
  settings            Settings[]
  coupons             Coupon[]
  payments            Payment[]
  appointments        Appointment[]
  workingHours        WorkingHours[]
  timeSlots           TimeSlot[]
  serviceTypes        ServiceType[]
  blockedDates        BlockedDate[]
  customerAddresses   CustomerAddress[]
  customerFavorites   CustomerFavorite[]
  productReviews      ProductReview[]
  customerPreferences CustomerPreference[]
  commissions         Commission[]
  payouts             Payout[]
  sellers             Seller[]
  plans               Plan[]

  refreshTokens RefreshToken[]

  paymentWebhookEvents PaymentWebhookEvent[]

  paymentSessions      PaymentSession[]
  returnRequests       ReturnRequest[]
  cashRegisterSessions CashRegisterSession[]
}

model User {
  id                     Int       @id @default(autoincrement())
  businessId             Int
  name                   String
  phone                  String    @unique
  email                  String?   @unique
  passwordHash           String?
  resetPasswordTokenHash String?
  resetPasswordExpiresAt DateTime?
  role                   Role
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())

  business            Business       @relation(fields: [businessId], references: [id])
  createdCustomers    Customer[]     @relation("CustomerCreatedBy")
  customerRecord      Customer?      @relation("UserCustomer")
  createdProducts     Product[]      @relation("ProductCreatedBy")
  createdCategories   Category[]     @relation("CategoryCreatedBy")
  createdOrders       Order[]        @relation("OrderCreatedBy")
  staffAppointments   Appointment[]  @relation("StaffAppointments")
  createdAppointments Appointment[]  @relation("CreatedAppointments")
  workingHours        WorkingHours[] @relation("StaffWorkingHours")
  timeSlots           TimeSlot[]     @relation("StaffTimeSlots")
  blockedDates        BlockedDate[]  @relation("StaffBlockedDates")

  commissionEntries          Commission[]          @relation("CommissionBeneficiary")
  payoutRequests             Payout[]              @relation("PayoutBeneficiary")
  decidedReturnRequests      ReturnRequest[]       @relation("ReturnRequestDecidedBy")
  openedCashRegisterSessions CashRegisterSession[] @relation("CashRegisterOpenedBy")
  closedCashRegisterSessions CashRegisterSession[] @relation("CashRegisterClosedBy")

  sellerProfile Seller?

  refreshTokens RefreshToken[]
}

model RefreshToken {
  id Int @id @default(autoincrement())

  businessId Int
  userId     Int

  // JWT ID; used to identify the token record even if the raw token is not stored.
  jti String @unique

  // Hash of the raw refresh JWT (sha256). Useful for constant-time lookups and token revocation.
  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  // Token rotation tracking
  replacedByTokenId Int?
  replacedByToken   RefreshToken?  @relation("RefreshTokenRotation", fields: [replacedByTokenId], references: [id])
  replacedTokens    RefreshToken[] @relation("RefreshTokenRotation")

  createdAt DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([businessId])
  @@index([businessId, userId])
  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Seller {
  id Int @id @default(autoincrement())

  businessId Int
  userId     Int @unique

  slug        String
  displayName String
  description String?
  logoUrl     String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([businessId, isActive])
}

model Category {
  id              Int       @id @default(autoincrement())
  businessId      Int
  createdByUserId Int
  name            String
  slug            String
  parentId        Int?
  isActive        Boolean   @default(true)
  orderIndex      Int       @default(0)
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business  Business   @relation(fields: [businessId], references: [id])
  createdBy User       @relation("CategoryCreatedBy", fields: [createdByUserId], references: [id])
  parent    Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryParent")
  products  Product[]

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([businessId, orderIndex])
  @@index([parentId])
  @@index([businessId, parentId])
}

model Customer {
  id              Int       @id @default(autoincrement())
  businessId      Int
  createdByUserId Int
  userId          Int?      @unique
  name            String
  phone           String
  balance         Int       @default(0)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  business       Business            @relation(fields: [businessId], references: [id])
  createdBy      User                @relation("CustomerCreatedBy", fields: [createdByUserId], references: [id])
  user           User?               @relation("UserCustomer", fields: [userId], references: [id])
  orders         Order[]
  appointments   Appointment[]
  addresses      CustomerAddress[]
  favorites      CustomerFavorite[]
  reviews        ProductReview[]
  preferences    CustomerPreference?
  returnRequests ReturnRequest[]

  @@unique([businessId, phone])
  @@index([businessId])
  @@index([businessId, deletedAt])
  @@index([userId])
}

model CustomerPreference {
  id         Int @id @default(autoincrement())
  businessId Int
  customerId Int @unique

  allowSms       Boolean   @default(true)
  allowEmail     Boolean   @default(true)
  allowMarketing Boolean   @default(false)
  kvkkConsent    Boolean   @default(false)
  kvkkConsentAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([businessId])
  @@index([businessId, customerId])
}

model CustomerAddress {
  id         Int @id @default(autoincrement())
  businessId Int
  customerId Int

  title    String
  fullName String
  phone    String

  line1      String
  line2      String?
  city       String
  district   String
  postalCode String?
  country    String  @default("TR")

  isDefaultShipping Boolean @default(false)
  isDefaultBilling  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([businessId])
  @@index([businessId, customerId])
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum PlanInterval {
  MONTHLY
  YEARLY
}

enum ProductType {
  PHYSICAL
  SERVICE
  WEIGHT
  CUSTOM
}

enum PayoutStatus {
  pending
  approved
  completed
}

model Commission {
  id Int @id @default(autoincrement())

  businessId        Int
  beneficiaryUserId Int
  orderId           Int @unique

  rate                  Float
  grossAmountCents      Int
  commissionAmountCents Int
  netAmountCents        Int

  createdAt DateTime @default(now())

  business        Business @relation(fields: [businessId], references: [id])
  beneficiaryUser User     @relation("CommissionBeneficiary", fields: [beneficiaryUserId], references: [id])
  order           Order    @relation("OrderCommission", fields: [orderId], references: [id])

  @@index([businessId])
  @@index([businessId, beneficiaryUserId])
}

model Payout {
  id Int @id @default(autoincrement())

  businessId        Int
  beneficiaryUserId Int

  amountCents Int
  status      PayoutStatus @default(pending)

  requestedAt DateTime  @default(now())
  approvedAt  DateTime?
  completedAt DateTime?

  business        Business @relation(fields: [businessId], references: [id])
  beneficiaryUser User     @relation("PayoutBeneficiary", fields: [beneficiaryUserId], references: [id])

  @@index([businessId])
  @@index([businessId, beneficiaryUserId])
  @@index([businessId, status])
}

model Product {
  id              Int         @id @default(autoincrement())
  businessId      Int
  createdByUserId Int
  categoryId      Int
  name            String
  subtitle        String?
  sku             String?
  type            ProductType
  priceCents      Int
  description     String?
  features        String[]    @default([])
  imageUrl        String?
  images          String[]    @default([])
  stock           Int?
  tags            String[]    @default([])
  seoTitle        String?
  seoDescription  String?
  isActive        Boolean     @default(true)
  archivedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  business      Business           @relation(fields: [businessId], references: [id])
  createdBy     User               @relation("ProductCreatedBy", fields: [createdByUserId], references: [id])
  category      Category           @relation(fields: [categoryId], references: [id])
  items         OrderItem[]
  variants      ProductVariant[]
  galleryImages ProductImage[]
  favoritedBy   CustomerFavorite[]
  reviews       ProductReview[]
  // @@unique([businessId, sku]) // enable when SKU uniqueness per business is required

  @@index([businessId])
  @@index([businessId, categoryId])
  @@index([businessId, isActive, createdAt])
  @@index([businessId, isActive, name])
}

model ProductVariant {
  id         Int @id @default(autoincrement())
  businessId Int
  productId  Int

  name       String
  sku        String?
  color      String?
  size       String?
  material   String?
  priceCents Int
  stock      Int?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business    @relation(fields: [businessId], references: [id])
  product  Product     @relation(fields: [productId], references: [id])
  items    OrderItem[]

  @@unique([businessId, productId, sku])
  @@index([businessId, productId])
  @@index([businessId, productId, isActive])
}

model ProductImage {
  id         Int      @id @default(autoincrement())
  businessId Int
  productId  Int
  url        String
  orderIndex Int      @default(0)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@index([businessId, productId])
  @@index([businessId, productId, orderIndex])
}

model OrderStatus {
  id         Int      @id @default(autoincrement())
  businessId Int
  key        String
  label      String
  orderIndex Int
  isFinal    Boolean  @default(false)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  orders   Order[]

  @@unique([businessId, key])
  @@index([businessId, orderIndex])
}

enum OrderSource {
  POS
  MOBILE
  WEB
  API
}

enum ReturnRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CouponType {
  PERCENT
  FIXED
}

model Order {
  id                     Int         @id @default(autoincrement())
  businessId             Int
  customerId             Int
  createdByUserId        Int
  statusId               Int
  subtotalAmountCents    Int         @default(0)
  taxAmountCents         Int         @default(0)
  taxRateBps             Int         @default(0)
  discountAmountCents    Int         @default(0)
  couponCode             String?
  totalAmountCents       Int         @default(0)
  source                 OrderSource @default(POS)
  notes                  String?
  idempotencyKey         String?
  idempotencyHash        String?
  shipmentCarrier        String?
  shipmentTrackingNumber String?
  deletedAt              DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  business   Business    @relation(fields: [businessId], references: [id])
  customer   Customer    @relation(fields: [customerId], references: [id])
  createdBy  User        @relation("OrderCreatedBy", fields: [createdByUserId], references: [id])
  status     OrderStatus @relation(fields: [statusId], references: [id])
  items      OrderItem[]
  payments   Payment[]
  commission Commission? @relation("OrderCommission")

  paymentSessions PaymentSession[]
  returnRequests  ReturnRequest[]

  @@index([businessId])
  @@index([businessId, customerId])
  @@index([businessId, deletedAt])
  @@index([businessId, statusId, createdAt])
  @@index([businessId, createdAt])
  @@unique([businessId, idempotencyKey])
}

model ReturnRequest {
  id Int @id @default(autoincrement())

  businessId Int
  orderId    Int
  customerId Int

  status       ReturnRequestStatus @default(PENDING)
  reason       String?
  responseNote String?

  requestedAt     DateTime  @default(now())
  decidedAt       DateTime?
  decidedByUserId Int?

  business  Business @relation(fields: [businessId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id])
  customer  Customer @relation(fields: [customerId], references: [id])
  decidedBy User?    @relation("ReturnRequestDecidedBy", fields: [decidedByUserId], references: [id])

  @@unique([businessId, orderId])
  @@index([businessId, status])
  @@index([businessId, customerId])
  @@index([businessId, requestedAt])
}

model CashRegisterSession {
  id Int @id @default(autoincrement())

  businessId     Int
  registerCode   String
  openedByUserId Int
  closedByUserId Int?

  openingCashCents Int
  closingCashCents Int?
  openNote         String?
  closeNote        String?

  openedAt  DateTime  @default(now())
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  openedBy User     @relation("CashRegisterOpenedBy", fields: [openedByUserId], references: [id])
  closedBy User?    @relation("CashRegisterClosedBy", fields: [closedByUserId], references: [id])

  @@index([businessId, openedAt])
  @@index([businessId, closedAt])
  @@index([businessId, registerCode, openedAt])
  @@index([openedByUserId])
  @@index([closedByUserId])
}

model Coupon {
  id                  Int        @id @default(autoincrement())
  businessId          Int
  code                String
  type                CouponType
  value               Int
  usageLimit          Int?
  usedCount           Int        @default(0)
  minOrderAmountCents Int?
  maxDiscountCents    Int?
  startsAt            DateTime?
  endsAt              DateTime?
  isActive            Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, code])
  @@index([businessId, isActive])
}

model OrderItem {
  id                  Int      @id @default(autoincrement())
  businessId          Int
  orderId             Int
  productId           Int
  variantId           Int?
  productName         String
  quantity            Int
  unitPriceCents      Int
  subtotalAmountCents Int
  taxAmountCents      Int      @default(0)
  taxRateBps          Int      @default(0)
  totalAmountCents    Int
  createdAt           DateTime @default(now())

  business Business        @relation(fields: [businessId], references: [id])
  order    Order           @relation(fields: [orderId], references: [id])
  product  Product         @relation(fields: [productId], references: [id])
  variant  ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([businessId, orderId])
  @@index([businessId, productId])
  @@index([businessId, variantId])
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum PaymentProvider {
  IYZICO
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

model Payment {
  id          Int           @id @default(autoincrement())
  businessId  Int
  orderId     Int
  amountCents Int
  method      PaymentMethod
  reference   String?
  createdAt   DateTime      @default(now())

  business Business @relation(fields: [businessId], references: [id])
  order    Order    @relation(fields: [orderId], references: [id])

  @@index([businessId, orderId])
  @@index([businessId, createdAt])
}

model PaymentWebhookEvent {
  id Int @id @default(autoincrement())

  businessId Int?
  provider   PaymentProvider

  // Provider specific unique identifier for idempotency
  eventId String

  eventType String?
  payload   Json
  signature String?

  status      WebhookEventStatus @default(RECEIVED)
  receivedAt  DateTime           @default(now())
  processedAt DateTime?
  error       String?

  business Business? @relation(fields: [businessId], references: [id])

  @@unique([provider, eventId])
  @@index([businessId])
  @@index([provider, status])
  @@index([receivedAt])
}

model PaymentSession {
  id Int @id @default(autoincrement())

  businessId Int
  provider   PaymentProvider

  // Token returned by provider on initialize (used for retrieve)
  token String

  orderId Int

  // Amount snapshot used when session was created
  amountCents Int

  // INITIATED | COMPLETED | FAILED
  status String @default("INITIATED")

  conversationId String?
  paymentId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  order    Order    @relation(fields: [orderId], references: [id])

  @@unique([provider, token])
  @@index([businessId])
  @@index([businessId, orderId])
  @@index([provider, status])
}

model Settings {
  id         Int      @id @default(autoincrement())
  businessId Int
  key        String
  value      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, key])
  @@index([businessId])
}

model Plan {
  id Int @id @default(autoincrement())

  businessId Int

  name       String
  interval   PlanInterval
  priceCents Int
  currency   String       @default("TRY")
  isActive   Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, name, interval])
  @@index([businessId])
  @@index([businessId, interval])
  @@index([businessId, isActive])
}

model CustomerFavorite {
  id         Int      @id @default(autoincrement())
  businessId Int
  customerId Int
  productId  Int
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([businessId, customerId, productId])
  @@index([businessId])
  @@index([businessId, customerId])
  @@index([businessId, productId])
}

model ProductReview {
  id         Int @id @default(autoincrement())
  businessId Int
  customerId Int
  productId  Int

  rating  Int
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([businessId, customerId, productId])
  @@index([businessId])
  @@index([businessId, productId])
  @@index([businessId, customerId])
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model ServiceType {
  id              Int      @id @default(autoincrement())
  businessId      Int
  name            String
  description     String?
  durationMinutes Int
  priceCents      Int?
  colorHex        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business     Business      @relation(fields: [businessId], references: [id])
  timeSlots    TimeSlot[]
  appointments Appointment[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([businessId, isActive])
}

model WorkingHours {
  id          Int      @id @default(autoincrement())
  businessId  Int
  staffUserId Int?
  weekday     Weekday
  startMinute Int
  endMinute   Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business  Business @relation(fields: [businessId], references: [id])
  staffUser User?    @relation("StaffWorkingHours", fields: [staffUserId], references: [id])

  @@unique([businessId, staffUserId, weekday, startMinute, endMinute])
  @@index([businessId])
  @@index([businessId, staffUserId, weekday, isActive])
}

model TimeSlot {
  id            Int      @id @default(autoincrement())
  businessId    Int
  staffUserId   Int?
  serviceTypeId Int?
  startAt       DateTime
  endAt         DateTime
  capacity      Int      @default(1)
  isAvailable   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business    Business     @relation(fields: [businessId], references: [id])
  staffUser   User?        @relation("StaffTimeSlots", fields: [staffUserId], references: [id])
  serviceType ServiceType? @relation(fields: [serviceTypeId], references: [id])

  @@unique([businessId, staffUserId, serviceTypeId, startAt, endAt])
  @@index([businessId])
  @@index([businessId, staffUserId, startAt])
  @@index([businessId, serviceTypeId, startAt])
}

model BlockedDate {
  id          Int      @id @default(autoincrement())
  businessId  Int
  staffUserId Int?
  date        DateTime @db.Date
  startMinute Int?
  endMinute   Int?
  isFullDay   Boolean  @default(true)
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business  Business @relation(fields: [businessId], references: [id])
  staffUser User?    @relation("StaffBlockedDates", fields: [staffUserId], references: [id])

  @@unique([businessId, staffUserId, date, startMinute, endMinute])
  @@index([businessId])
  @@index([businessId, date])
  @@index([businessId, staffUserId, date])
}

model Appointment {
  id              Int               @id @default(autoincrement())
  businessId      Int
  customerId      Int
  staffUserId     Int?
  serviceTypeId   Int?
  startAt         DateTime
  endAt           DateTime
  status          AppointmentStatus
  serviceName     String
  notes           String?
  createdByUserId Int
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  business    Business     @relation(fields: [businessId], references: [id])
  customer    Customer     @relation(fields: [customerId], references: [id])
  staffUser   User?        @relation("StaffAppointments", fields: [staffUserId], references: [id])
  serviceType ServiceType? @relation(fields: [serviceTypeId], references: [id])
  createdBy   User         @relation("CreatedAppointments", fields: [createdByUserId], references: [id])

  @@index([businessId])
  @@index([businessId, staffUserId])
  @@index([businessId, customerId])
  @@index([businessId, startAt])
  @@index([businessId, serviceTypeId, startAt])
}
