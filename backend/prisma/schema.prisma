// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())

  users               User[]
  customers           Customer[]
  products            Product[]
  productVariants     ProductVariant[]
  productImages       ProductImage[]
  categories          Category[]
  orders              Order[]
  orderStatuses       OrderStatus[]
  orderItems          OrderItem[]
  settings            Settings[]
  coupons             Coupon[]
  payments            Payment[]
  appointments        Appointment[]
  workingHours        WorkingHours[]
  timeSlots           TimeSlot[]
  serviceTypes        ServiceType[]
  blockedDates        BlockedDate[]
  customerAddresses   CustomerAddress[]
  customerFavorites   CustomerFavorite[]
  productReviews      ProductReview[]
  customerPreferences CustomerPreference[]
  commissions         Commission[]
  payouts             Payout[]
  sellers             Seller[]
  sellerTeamMembers   SellerTeamMember[]
  sellerInvites       SellerInvite[]
  sellerInviteDeliveries SellerInviteDelivery[]
  calculationProfiles      CalculationProfile[]
  commissionRules          CommissionRule[]
  commissionCategoryOverrides CommissionCategoryOverride[]
  sellerChannelRuleBindings SellerChannelRuleBinding[]
  sellerWallets         SellerWallet[]
  platformWallets       PlatformWallet[]
  financeLedgerEntries  FinanceLedgerEntry[]
  payoutRequests        PayoutRequest[]
  customerLedger      CustomerLedgerEntry[]
  auditLogs           AuditLog[]
  outboxEvents        OutboxEvent[]
  plans               Plan[]

  refreshTokens RefreshToken[]

  paymentWebhookEvents PaymentWebhookEvent[]

  paymentSessions      PaymentSession[]
  returnRequests       ReturnRequest[]
  cashRegisterSessions CashRegisterSession[]
}

model User {
  id                     Int       @id @default(autoincrement())
  businessId             Int
  name                   String
  phone                  String    @unique
  email                  String?   @unique
  passwordHash           String?
  resetPasswordTokenHash String?
  resetPasswordExpiresAt DateTime?
  role                   Role
  isActive               Boolean   @default(true)
  createdAt              DateTime  @default(now())

  business            Business       @relation(fields: [businessId], references: [id])
  createdCustomers    Customer[]     @relation("CustomerCreatedBy")
  customerRecord      Customer?      @relation("UserCustomer")
  createdProducts     Product[]      @relation("ProductCreatedBy")
  createdCategories   Category[]     @relation("CategoryCreatedBy")
  createdOrders       Order[]        @relation("OrderCreatedBy")
  staffAppointments   Appointment[]  @relation("StaffAppointments")
  createdAppointments Appointment[]  @relation("CreatedAppointments")
  workingHours        WorkingHours[] @relation("StaffWorkingHours")
  timeSlots           TimeSlot[]     @relation("StaffTimeSlots")
  blockedDates        BlockedDate[]  @relation("StaffBlockedDates")

  commissionEntries          Commission[]          @relation("CommissionBeneficiary")
  payoutRequests             Payout[]              @relation("PayoutBeneficiary")
  decidedReturnRequests      ReturnRequest[]       @relation("ReturnRequestDecidedBy")
  openedCashRegisterSessions CashRegisterSession[] @relation("CashRegisterOpenedBy")
  closedCashRegisterSessions CashRegisterSession[] @relation("CashRegisterClosedBy")
  sellerTeamMemberships      SellerTeamMember[]    @relation("SellerTeamMemberUser")
  createdSellerTeamMembers   SellerTeamMember[]    @relation("SellerTeamMemberInvitedBy")
  receivedSellerInvites      SellerInvite[]        @relation("SellerInviteTargetUser")
  sentSellerInvites          SellerInvite[]        @relation("SellerInviteInvitedBy")
  createdPayments            Payment[]             @relation("PaymentCreatedBy")
  createdCustomerLedger      CustomerLedgerEntry[] @relation("CustomerLedgerCreatedBy")
  auditLogsAsActor           AuditLog[]            @relation("AuditLogActor")

  sellerProfile Seller?

  refreshTokens RefreshToken[]
}

model RefreshToken {
  id Int @id @default(autoincrement())

  businessId Int
  userId     Int

  // JWT ID; used to identify the token record even if the raw token is not stored.
  jti String @unique

  // Hash of the raw refresh JWT (sha256). Useful for constant-time lookups and token revocation.
  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  // Token rotation tracking
  replacedByTokenId Int?
  replacedByToken   RefreshToken?  @relation("RefreshTokenRotation", fields: [replacedByTokenId], references: [id])
  replacedTokens    RefreshToken[] @relation("RefreshTokenRotation")

  createdAt DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@index([businessId])
  @@index([businessId, userId])
  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model Seller {
  id Int @id @default(autoincrement())

  businessId Int
  userId     Int @unique

  slug        String
  displayName String
  description String?
  logoUrl     String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business       Business              @relation(fields: [businessId], references: [id])
  user           User                  @relation(fields: [userId], references: [id])
  products       Product[]             @relation("SellerProducts")
  categories     Category[]            @relation("SellerCategories")
  orders         Order[]               @relation("SellerOrders")
  payments       Payment[]             @relation("SellerPayments")
  teamMembers    SellerTeamMember[]
  invites        SellerInvite[]
  channelRuleBindings SellerChannelRuleBinding[]
  wallets        SellerWallet[]
  payoutRequests PayoutRequest[]
  financeLedgerEntries FinanceLedgerEntry[]
  customerLedger CustomerLedgerEntry[]

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([businessId, isActive])
}

model SellerTeamMember {
  id              Int      @id @default(autoincrement())
  businessId      Int
  sellerId        Int
  userId          Int
  invitedByUserId Int?
  isActive        Boolean  @default(true)
  permissionsJson Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business  Business @relation(fields: [businessId], references: [id])
  seller    Seller   @relation(fields: [sellerId], references: [id])
  user      User     @relation("SellerTeamMemberUser", fields: [userId], references: [id])
  invitedBy User?    @relation("SellerTeamMemberInvitedBy", fields: [invitedByUserId], references: [id])

  @@unique([sellerId, userId])
  @@index([businessId, sellerId, isActive])
  @@index([businessId, userId, isActive])
}

model SellerInvite {
  id              Int                @id @default(autoincrement())
  businessId      Int
  sellerId        Int
  targetUserId    Int
  invitedByUserId Int
  status          SellerInviteStatus @default(PENDING)
  token           String             @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  business      Business @relation(fields: [businessId], references: [id])
  seller        Seller   @relation(fields: [sellerId], references: [id])
  targetUser    User     @relation("SellerInviteTargetUser", fields: [targetUserId], references: [id])
  invitedByUser User     @relation("SellerInviteInvitedBy", fields: [invitedByUserId], references: [id])
  deliveries    SellerInviteDelivery[]

  @@index([businessId, sellerId, status, createdAt])
  @@index([businessId, targetUserId, status, createdAt])
}

model SellerInviteDelivery {
  id           Int                  @id @default(autoincrement())
  businessId   Int
  inviteId     Int
  channel      InviteDeliveryChannel
  status       InviteDeliveryStatus @default(PENDING)
  target       String
  attemptCount Int                  @default(0)
  maxAttempts  Int                  @default(3)
  nextRetryAt  DateTime?
  lastAttemptAt DateTime?
  lastError    String?
  sentAt       DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  business Business     @relation(fields: [businessId], references: [id])
  invite   SellerInvite @relation(fields: [inviteId], references: [id])

  @@unique([inviteId, channel])
  @@index([businessId, status, nextRetryAt, createdAt])
  @@index([businessId, inviteId, channel])
}

model Category {
  id              Int               @id @default(autoincrement())
  businessId      Int
  createdByUserId Int
  sellerId        Int?
  scopeType       CategoryScopeType @default(GLOBAL)
  name            String
  slug            String
  parentId        Int?
  isActive        Boolean           @default(true)
  orderIndex      Int               @default(0)
  archivedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  business  Business   @relation(fields: [businessId], references: [id])
  createdBy User       @relation("CategoryCreatedBy", fields: [createdByUserId], references: [id])
  seller    Seller?    @relation("SellerCategories", fields: [sellerId], references: [id])
  parent    Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryParent")
  products  Product[]
  commissionCategoryOverrides CommissionCategoryOverride[]

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([businessId, orderIndex])
  @@index([parentId])
  @@index([businessId, parentId])
  @@index([businessId, scopeType])
  @@index([businessId, sellerId, parentId])
  @@index([businessId, sellerId, orderIndex])
}

model Customer {
  id                Int               @id @default(autoincrement())
  businessId        Int
  createdByUserId   Int
  userId            Int?              @unique
  name              String
  phone             String
  balance           Int               @default(0)
  creditLimitCents  Int?
  creditBlockPolicy CreditBlockPolicy @default(WARN)
  deletedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  business       Business              @relation(fields: [businessId], references: [id])
  createdBy      User                  @relation("CustomerCreatedBy", fields: [createdByUserId], references: [id])
  user           User?                 @relation("UserCustomer", fields: [userId], references: [id])
  orders         Order[]
  appointments   Appointment[]
  addresses      CustomerAddress[]
  favorites      CustomerFavorite[]
  reviews        ProductReview[]
  preferences    CustomerPreference?
  returnRequests ReturnRequest[]
  ledgerEntries  CustomerLedgerEntry[]

  @@unique([businessId, phone])
  @@index([businessId])
  @@index([businessId, deletedAt])
  @@index([userId])
}

model CustomerPreference {
  id         Int @id @default(autoincrement())
  businessId Int
  customerId Int @unique

  allowSms       Boolean   @default(true)
  allowEmail     Boolean   @default(true)
  allowMarketing Boolean   @default(false)
  kvkkConsent    Boolean   @default(false)
  kvkkConsentAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([businessId])
  @@index([businessId, customerId])
}

model CustomerAddress {
  id         Int @id @default(autoincrement())
  businessId Int
  customerId Int

  title    String
  fullName String
  phone    String

  line1      String
  line2      String?
  city       String
  district   String
  postalCode String?
  country    String  @default("TR")

  isDefaultShipping Boolean @default(false)
  isDefaultBilling  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([businessId])
  @@index([businessId, customerId])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SELLER
  USER
  CUSTOMER
}

enum CategoryScopeType {
  GLOBAL
  SELLER_STORE
}

enum SellerInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum InviteDeliveryChannel {
  EMAIL
  SMS
}

enum InviteDeliveryStatus {
  PENDING
  SENT
  RETRY
  DEAD_LETTER
}

enum CreditBlockPolicy {
  NONE
  WARN
  BLOCK
}

enum LedgerEntryType {
  DEBIT
  CREDIT
}

enum LedgerSourceType {
  SALE_DEBIT
  PAYMENT_CREDIT
  RETURN_REVERSAL
  CANCEL_REVERSAL
  MANUAL_ADJUSTMENT
}

enum PlanInterval {
  MONTHLY
  YEARLY
}

enum ProductType {
  PHYSICAL
  SERVICE
  WEIGHT
  CUSTOM
}

enum PayoutStatus {
  pending
  approved
  completed
}

enum PayoutRequestStatus {
  REQUESTED
  APPROVED
  PAID
  REJECTED
}

enum FinanceLedgerDirection {
  DEBIT
  CREDIT
}

enum FinanceLedgerAccountType {
  CLEARING
  SELLER_PENDING
  SELLER_AVAILABLE
  PLATFORM_PENDING
  PLATFORM_AVAILABLE
  PLATFORM_REVENUE
  PLATFORM_RESERVE
}

enum FinanceLedgerEventType {
  ORDER_SALE
  ORDER_REFUND
  RELEASE_AVAILABLE
  PAYOUT_REQUEST
  PAYOUT_PAID
  MANUAL_ADJUSTMENT
}

enum CommerceChannel {
  MARKETPLACE
  POS
  MANUAL
}

enum CommissionRuleType {
  PERCENT
  FIXED
}

enum RoundingMode {
  HALF_UP
}

model CalculationProfile {
  id Int @id @default(autoincrement())

  businessId Int

  code         String
  name         String
  description  String?
  currency     String       @default("TRY")
  taxInclusive Boolean      @default(true)
  taxProfileCode String     @default("TR_STD")
  roundingMode RoundingMode @default(HALF_UP)
  discountRulesJson Json?
  isActive     Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business       Business                  @relation(fields: [businessId], references: [id])
  commissionRule CommissionRule?
  channelBindings SellerChannelRuleBinding[]

  @@unique([businessId, code])
  @@index([businessId])
  @@index([businessId, isActive])
}

model CommissionRule {
  id Int @id @default(autoincrement())

  businessId Int
  calculationProfileId Int @unique

  type CommissionRuleType
  rateBps Int?
  fixedAmountCents Int?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  calculationProfile CalculationProfile @relation(fields: [calculationProfileId], references: [id])
  categoryOverrides CommissionCategoryOverride[]

  @@index([businessId])
  @@index([businessId, isActive])
}

model CommissionCategoryOverride {
  id Int @id @default(autoincrement())

  businessId Int
  commissionRuleId Int
  categoryId Int

  type CommissionRuleType
  rateBps Int?
  fixedAmountCents Int?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  commissionRule CommissionRule @relation(fields: [commissionRuleId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([commissionRuleId, categoryId])
  @@index([businessId, categoryId])
  @@index([businessId, isActive])
}

model SellerChannelRuleBinding {
  id Int @id @default(autoincrement())

  businessId Int
  sellerId Int
  channel CommerceChannel
  calculationProfileId Int
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  seller Seller @relation(fields: [sellerId], references: [id])
  calculationProfile CalculationProfile @relation(fields: [calculationProfileId], references: [id])

  @@unique([businessId, sellerId, channel])
  @@index([businessId, calculationProfileId])
  @@index([businessId, channel, isActive])
}

model SellerWallet {
  id Int @id @default(autoincrement())

  businessId Int
  sellerId Int
  currency String @default("TRY")
  pendingBalanceCents Int @default(0)
  availableBalanceCents Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  seller Seller @relation(fields: [sellerId], references: [id])

  @@unique([businessId, sellerId, currency])
  @@index([businessId, sellerId])
}

model PlatformWallet {
  id Int @id @default(autoincrement())

  businessId Int
  currency String @default("TRY")
  pendingBalanceCents Int @default(0)
  availableBalanceCents Int @default(0)
  reserveBalanceCents Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, currency])
  @@index([businessId])
}

model PayoutRequest {
  id Int @id @default(autoincrement())

  businessId Int
  sellerId Int
  amountCents Int
  currency String @default("TRY")
  status PayoutRequestStatus @default(REQUESTED)
  approvedAt DateTime?
  paidAt DateTime?
  rejectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  seller Seller @relation(fields: [sellerId], references: [id])
  financeLedgerEntries FinanceLedgerEntry[]

  @@index([businessId, sellerId, status])
  @@index([businessId, status, createdAt])
}

model FinanceLedgerEntry {
  id Int @id @default(autoincrement())

  businessId Int
  eventId String
  eventType FinanceLedgerEventType
  accountType FinanceLedgerAccountType
  direction FinanceLedgerDirection
  amountCents Int
  currency String @default("TRY")
  orderId Int?
  sellerId Int?
  payoutRequestId Int?
  metadata Json?

  createdAt DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])
  seller Seller? @relation(fields: [sellerId], references: [id])
  payoutRequest PayoutRequest? @relation(fields: [payoutRequestId], references: [id])

  @@index([businessId, eventId, createdAt])
  @@index([businessId, eventType, createdAt])
  @@index([businessId, orderId, createdAt])
  @@index([businessId, sellerId, createdAt])
  @@index([businessId, payoutRequestId, createdAt])
}

model Commission {
  id Int @id @default(autoincrement())

  businessId        Int
  beneficiaryUserId Int
  orderId           Int @unique

  rate                  Float
  grossAmountCents      Int
  commissionAmountCents Int
  netAmountCents        Int

  createdAt DateTime @default(now())

  business        Business @relation(fields: [businessId], references: [id])
  beneficiaryUser User     @relation("CommissionBeneficiary", fields: [beneficiaryUserId], references: [id])
  order           Order    @relation("OrderCommission", fields: [orderId], references: [id])

  @@index([businessId])
  @@index([businessId, beneficiaryUserId])
}

model Payout {
  id Int @id @default(autoincrement())

  businessId        Int
  beneficiaryUserId Int

  amountCents Int
  status      PayoutStatus @default(pending)

  requestedAt DateTime  @default(now())
  approvedAt  DateTime?
  completedAt DateTime?

  business        Business @relation(fields: [businessId], references: [id])
  beneficiaryUser User     @relation("PayoutBeneficiary", fields: [beneficiaryUserId], references: [id])

  @@index([businessId])
  @@index([businessId, beneficiaryUserId])
  @@index([businessId, status])
}

model Product {
  id              Int         @id @default(autoincrement())
  businessId      Int
  createdByUserId Int
  categoryId      Int
  ownerSellerId   Int?
  name            String
  subtitle        String?
  sku             String?
  type            ProductType
  priceCents      Int
  costPriceCents  Int         @default(0)
  description     String?
  features        String[]    @default([])
  imageUrl        String?
  images          String[]    @default([])
  stock           Int?
  isPublished     Boolean     @default(false)
  publishedAt     DateTime?
  tags            String[]    @default([])
  seoTitle        String?
  seoDescription  String?
  isActive        Boolean     @default(true)
  archivedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  business      Business           @relation(fields: [businessId], references: [id])
  createdBy     User               @relation("ProductCreatedBy", fields: [createdByUserId], references: [id])
  category      Category           @relation(fields: [categoryId], references: [id])
  ownerSeller   Seller?            @relation("SellerProducts", fields: [ownerSellerId], references: [id])
  items         OrderItem[]
  variants      ProductVariant[]
  galleryImages ProductImage[]
  favoritedBy   CustomerFavorite[]
  reviews       ProductReview[]
  // @@unique([businessId, sku]) // enable when SKU uniqueness per business is required

  @@index([businessId])
  @@index([businessId, categoryId])
  @@index([businessId, isActive, createdAt])
  @@index([businessId, isActive, name])
  @@index([businessId, ownerSellerId, isPublished])
  @@index([businessId, ownerSellerId, isActive, createdAt])
}

model ProductVariant {
  id         Int @id @default(autoincrement())
  businessId Int
  productId  Int

  name       String
  sku        String?
  color      String?
  size       String?
  material   String?
  priceCents Int
  stock      Int?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business    @relation(fields: [businessId], references: [id])
  product  Product     @relation(fields: [productId], references: [id])
  items    OrderItem[]

  @@unique([businessId, productId, sku])
  @@index([businessId, productId])
  @@index([businessId, productId, isActive])
}

model ProductImage {
  id         Int      @id @default(autoincrement())
  businessId Int
  productId  Int
  url        String
  orderIndex Int      @default(0)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@index([businessId, productId])
  @@index([businessId, productId, orderIndex])
}

model OrderStatus {
  id         Int      @id @default(autoincrement())
  businessId Int
  key        String
  label      String
  orderIndex Int
  isFinal    Boolean  @default(false)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  orders   Order[]

  @@unique([businessId, key])
  @@index([businessId, orderIndex])
}

enum OrderSource {
  POS
  MOBILE
  WEB
  API
}

enum ReturnRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CouponType {
  PERCENT
  FIXED
}

model Order {
  id                     Int         @id @default(autoincrement())
  businessId             Int
  customerId             Int
  createdByUserId        Int
  sellerId               Int?
  statusId               Int
  subtotalAmountCents    Int         @default(0)
  taxAmountCents         Int         @default(0)
  taxRateBps             Int         @default(0)
  discountAmountCents    Int         @default(0)
  couponCode             String?
  totalAmountCents       Int         @default(0)
  shippingCostCents      Int         @default(0)
  commissionSnapshotCents Int        @default(0)
  platformRevenueCents   Int         @default(0)
  sellerPayoutCents      Int         @default(0)
  currency               String      @default("TRY")
  calculationProfileId   String?
  calculationVersion     String?
  breakdownJson          Json?
  priceMismatch          Boolean     @default(false)
  priceMismatchMetaJson  Json?
  countryCode            String      @default("TR")
  taxProfileCode         String?
  commissionProfileCode  String?
  returnCostCents        Int         @default(0)
  payoutReleasedAt       DateTime?
  source                 OrderSource @default(POS)
  notes                  String?
  idempotencyKey         String?
  idempotencyOperation   String?
  idempotencyChannel     CommerceChannel?
  idempotencyHash        String?
  shipmentCarrier        String?
  shipmentTrackingNumber String?
  deletedAt              DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  business      Business              @relation(fields: [businessId], references: [id])
  customer      Customer              @relation(fields: [customerId], references: [id])
  createdBy     User                  @relation("OrderCreatedBy", fields: [createdByUserId], references: [id])
  seller        Seller?               @relation("SellerOrders", fields: [sellerId], references: [id])
  status        OrderStatus           @relation(fields: [statusId], references: [id])
  items         OrderItem[]
  payments      Payment[]
  ledgerEntries CustomerLedgerEntry[]
  financeLedgerEntries FinanceLedgerEntry[]
  commission    Commission?           @relation("OrderCommission")

  paymentSessions PaymentSession[]
  returnRequests  ReturnRequest[]

  @@unique([businessId, idempotencyOperation, idempotencyChannel, idempotencyKey])
  @@index([businessId])
  @@index([businessId, customerId])
  @@index([businessId, deletedAt])
  @@index([businessId, statusId, createdAt])
  @@index([businessId, createdAt])
  @@index([businessId, sellerId, createdAt])
  @@index([businessId, idempotencyKey])
  @@index([businessId, priceMismatch, createdAt])
  @@index([businessId, payoutReleasedAt, createdAt])
}

model ReturnRequest {
  id Int @id @default(autoincrement())

  businessId Int
  orderId    Int
  customerId Int

  status       ReturnRequestStatus @default(PENDING)
  reason       String?
  responseNote String?

  requestedAt     DateTime  @default(now())
  decidedAt       DateTime?
  decidedByUserId Int?

  business  Business @relation(fields: [businessId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id])
  customer  Customer @relation(fields: [customerId], references: [id])
  decidedBy User?    @relation("ReturnRequestDecidedBy", fields: [decidedByUserId], references: [id])

  @@unique([businessId, orderId])
  @@index([businessId, status])
  @@index([businessId, customerId])
  @@index([businessId, requestedAt])
}

model CashRegisterSession {
  id Int @id @default(autoincrement())

  businessId     Int
  registerCode   String
  openedByUserId Int
  closedByUserId Int?

  openingCashCents Int
  closingCashCents Int?
  openNote         String?
  closeNote        String?

  openedAt  DateTime  @default(now())
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  openedBy User     @relation("CashRegisterOpenedBy", fields: [openedByUserId], references: [id])
  closedBy User?    @relation("CashRegisterClosedBy", fields: [closedByUserId], references: [id])

  @@index([businessId, openedAt])
  @@index([businessId, closedAt])
  @@index([businessId, registerCode, openedAt])
  @@index([openedByUserId])
  @@index([closedByUserId])
}

model Coupon {
  id                  Int        @id @default(autoincrement())
  businessId          Int
  code                String
  type                CouponType
  value               Int
  usageLimit          Int?
  usedCount           Int        @default(0)
  minOrderAmountCents Int?
  maxDiscountCents    Int?
  startsAt            DateTime?
  endsAt              DateTime?
  isActive            Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, code])
  @@index([businessId, isActive])
}

model OrderItem {
  id                  Int      @id @default(autoincrement())
  businessId          Int
  orderId             Int
  productId           Int
  variantId           Int?
  productName         String
  quantity            Int
  unitPriceCents      Int
  subtotalAmountCents Int
  taxAmountCents      Int      @default(0)
  taxRateBps          Int      @default(0)
  totalAmountCents    Int
  costSnapshotCents   Int      @default(0)
  shippingAllocationCents   Int      @default(0)
  commissionAllocationCents Int      @default(0)
  returnAllocationCents     Int      @default(0)
  netProfitV2Cents          Int      @default(0)
  createdAt           DateTime @default(now())

  business Business        @relation(fields: [businessId], references: [id])
  order    Order           @relation(fields: [orderId], references: [id])
  product  Product         @relation(fields: [productId], references: [id])
  variant  ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([businessId, orderId])
  @@index([businessId, productId])
  @@index([businessId, variantId])
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  OTHER
}

enum PaymentProvider {
  IYZICO
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

model Payment {
  id              Int           @id @default(autoincrement())
  businessId      Int
  orderId         Int
  sellerId        Int?
  createdByUserId Int?
  amountCents     Int
  method          PaymentMethod
  reference       String?
  createdAt       DateTime      @default(now())

  business  Business @relation(fields: [businessId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id])
  seller    Seller?  @relation("SellerPayments", fields: [sellerId], references: [id])
  createdBy User?    @relation("PaymentCreatedBy", fields: [createdByUserId], references: [id])

  @@index([businessId, orderId])
  @@index([businessId, createdAt])
  @@index([businessId, sellerId, createdAt])
}

model PaymentWebhookEvent {
  id Int @id @default(autoincrement())

  businessId Int?
  provider   PaymentProvider

  // Provider specific unique identifier for idempotency
  eventId String

  eventType String?
  payload   Json
  signature String?

  status      WebhookEventStatus @default(RECEIVED)
  receivedAt  DateTime           @default(now())
  processedAt DateTime?
  error       String?

  business Business? @relation(fields: [businessId], references: [id])

  @@unique([provider, eventId])
  @@index([businessId])
  @@index([provider, status])
  @@index([receivedAt])
}

model PaymentSession {
  id Int @id @default(autoincrement())

  businessId Int
  provider   PaymentProvider

  // Token returned by provider on initialize (used for retrieve)
  token String

  orderId Int

  // Amount snapshot used when session was created
  amountCents Int

  // INITIATED | COMPLETED | FAILED
  status String @default("INITIATED")

  conversationId String?
  paymentId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  order    Order    @relation(fields: [orderId], references: [id])

  @@unique([provider, token])
  @@index([businessId])
  @@index([businessId, orderId])
  @@index([provider, status])
}

model CustomerLedgerEntry {
  id                Int              @id @default(autoincrement())
  businessId        Int
  sellerId          Int
  customerId        Int
  orderId           Int?
  type              LedgerEntryType
  sourceType        LedgerSourceType
  amountCents       Int
  balanceAfterCents Int
  createdByUserId   Int?
  createdAt         DateTime         @default(now())

  business  Business @relation(fields: [businessId], references: [id])
  seller    Seller   @relation(fields: [sellerId], references: [id])
  customer  Customer @relation(fields: [customerId], references: [id])
  order     Order?   @relation(fields: [orderId], references: [id])
  createdBy User?    @relation("CustomerLedgerCreatedBy", fields: [createdByUserId], references: [id])

  @@index([businessId, sellerId, customerId, createdAt])
  @@index([businessId, sellerId, createdAt])
  @@index([businessId, orderId])
}

model OutboxEvent {
  id            Int       @id @default(autoincrement())
  businessId    Int
  aggregateType String
  aggregateId   String
  eventType     String
  idempotencyKey String?
  payloadJson   Json
  attemptCount  Int       @default(0)
  nextRetryAt   DateTime?
  processingStartedAt DateTime?
  lastError     String?
  deadLetteredAt DateTime?
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, aggregateType, aggregateId, eventType, idempotencyKey])
  @@index([businessId, aggregateType, aggregateId])
  @@index([businessId, eventType, createdAt])
  @@index([processedAt])
  @@index([processedAt, deadLetteredAt, nextRetryAt])
  @@index([businessId, deadLetteredAt, createdAt])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  businessId  Int
  actorRole   Role
  actorUserId Int
  actionType  String
  targetType  String
  targetId    String
  payloadJson Json
  createdAt   DateTime @default(now())

  business  Business @relation(fields: [businessId], references: [id])
  actorUser User     @relation("AuditLogActor", fields: [actorUserId], references: [id])

  @@index([businessId, actionType, createdAt])
  @@index([businessId, actorUserId, createdAt])
  @@index([businessId, targetType, targetId, createdAt])
}

model Settings {
  id         Int      @id @default(autoincrement())
  businessId Int
  key        String
  value      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, key])
  @@index([businessId])
}

model Plan {
  id Int @id @default(autoincrement())

  businessId Int

  name       String
  interval   PlanInterval
  priceCents Int
  currency   String       @default("TRY")
  isActive   Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, name, interval])
  @@index([businessId])
  @@index([businessId, interval])
  @@index([businessId, isActive])
}

model CustomerFavorite {
  id         Int      @id @default(autoincrement())
  businessId Int
  customerId Int
  productId  Int
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([businessId, customerId, productId])
  @@index([businessId])
  @@index([businessId, customerId])
  @@index([businessId, productId])
}

model ProductReview {
  id         Int @id @default(autoincrement())
  businessId Int
  customerId Int
  productId  Int

  rating  Int
  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([businessId, customerId, productId])
  @@index([businessId])
  @@index([businessId, productId])
  @@index([businessId, customerId])
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model ServiceType {
  id              Int      @id @default(autoincrement())
  businessId      Int
  name            String
  description     String?
  durationMinutes Int
  priceCents      Int?
  colorHex        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business     Business      @relation(fields: [businessId], references: [id])
  timeSlots    TimeSlot[]
  appointments Appointment[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([businessId, isActive])
}

model WorkingHours {
  id          Int      @id @default(autoincrement())
  businessId  Int
  staffUserId Int?
  weekday     Weekday
  startMinute Int
  endMinute   Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business  Business @relation(fields: [businessId], references: [id])
  staffUser User?    @relation("StaffWorkingHours", fields: [staffUserId], references: [id])

  @@unique([businessId, staffUserId, weekday, startMinute, endMinute])
  @@index([businessId])
  @@index([businessId, staffUserId, weekday, isActive])
}

model TimeSlot {
  id            Int      @id @default(autoincrement())
  businessId    Int
  staffUserId   Int?
  serviceTypeId Int?
  startAt       DateTime
  endAt         DateTime
  capacity      Int      @default(1)
  isAvailable   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  business    Business     @relation(fields: [businessId], references: [id])
  staffUser   User?        @relation("StaffTimeSlots", fields: [staffUserId], references: [id])
  serviceType ServiceType? @relation(fields: [serviceTypeId], references: [id])

  @@unique([businessId, staffUserId, serviceTypeId, startAt, endAt])
  @@index([businessId])
  @@index([businessId, staffUserId, startAt])
  @@index([businessId, serviceTypeId, startAt])
}

model BlockedDate {
  id          Int      @id @default(autoincrement())
  businessId  Int
  staffUserId Int?
  date        DateTime @db.Date
  startMinute Int?
  endMinute   Int?
  isFullDay   Boolean  @default(true)
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business  Business @relation(fields: [businessId], references: [id])
  staffUser User?    @relation("StaffBlockedDates", fields: [staffUserId], references: [id])

  @@unique([businessId, staffUserId, date, startMinute, endMinute])
  @@index([businessId])
  @@index([businessId, date])
  @@index([businessId, staffUserId, date])
}

model Appointment {
  id              Int               @id @default(autoincrement())
  businessId      Int
  customerId      Int
  staffUserId     Int?
  serviceTypeId   Int?
  startAt         DateTime
  endAt           DateTime
  status          AppointmentStatus
  serviceName     String
  notes           String?
  createdByUserId Int
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  business    Business     @relation(fields: [businessId], references: [id])
  customer    Customer     @relation(fields: [customerId], references: [id])
  staffUser   User?        @relation("StaffAppointments", fields: [staffUserId], references: [id])
  serviceType ServiceType? @relation(fields: [serviceTypeId], references: [id])
  createdBy   User         @relation("CreatedAppointments", fields: [createdByUserId], references: [id])

  @@index([businessId])
  @@index([businessId, staffUserId])
  @@index([businessId, customerId])
  @@index([businessId, startAt])
  @@index([businessId, serviceTypeId, startAt])
}
