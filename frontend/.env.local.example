# Frontend environment variables (example)

# API base URL (must include /api/v1 prefix because frontend axios uses it)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Optional: used by backend email links; kept here for clarity
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Optional: Sentry (frontend and server runtime)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
